# kb-mcp environment variables
# Copy this file to .env.mcp and fill in real values. .env.mcp is git-ignored.
#
# This file is read by docker-compose when starting kb-mcp. The kb-mcp
# container reads only KB_DB_PATH from this; the variables below are
# placeholders for the broader MCP stack and may be referenced by
# sibling services (inventory-mcp, etc.).

# SQLite database path inside the container. Override only if you mount
# a different volume layout.
KB_DB_PATH=/data/kb.db
